+        if app_name != "RustDesk" {
+            if let Ok(installed) = remote_printer::is_rd_printer_installed(app_name) {
+                if !installed {
+                    log::info!("Custom printer '{} Printer' is not installed, skipping DLL init to prevent crash.", app_name);
+                    return Ok(());
+                }
+            }
+        }
+    }
